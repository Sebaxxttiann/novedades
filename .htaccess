Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
</IfModule>

<FilesMatch "^(composer\.(json|lock)|README\.md|\.gitignore)$">
    Require all denied
</FilesMatch>
